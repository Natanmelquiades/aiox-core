{
  "aiox_version": "5.4.1",
  "roles": [
    {
      "id": "aiox-master",
      "file": "aiox-master.md",
      "skill": "aiox-agent-aiox-master",
      "display": "Orion",
      "title": "AIOX Master Orchestrator & Framework Developer",
      "when": "Use when you need comprehensive expertise across all domains, framework component creation/modification, workflow orchestration, or running tasks that don't require a specialized persona."
    },
    {
      "id": "analyst",
      "file": "analyst.md",
      "skill": "aiox-agent-analyst",
      "display": "Atlas",
      "title": "Business Analyst",
      "when": "Use for market research, competitive analysis, user research, brainstorming session facilitation, structured ideation workshops, feasibility studies, industry trends analysis, project discovery (brownfield documentation), and research report creation.\n\nNOT for: PRD creation or product strategy → Use @pm. Technical architecture decisions or technology selection → Use @architect. Story creation or sprint planning → Use @sm.\n"
    },
    {
      "id": "architect",
      "file": "architect.md",
      "skill": "aiox-agent-architect",
      "display": "Aria",
      "title": "Architect",
      "when": "Use for system architecture (fullstack, backend, frontend, infrastructure), technology stack selection (technical evaluation), API design (REST/GraphQL/tRPC/WebSocket), security architecture, performance optimization, deployment strategy, and cross-cutting concerns (logging, monitoring, error handling).\n\nNOT for: Market research or competitive analysis → Use @analyst. PRD creation or product strategy → Use @pm. Database schema design or query optimization → Use @data-engineer.\n"
    },
    {
      "id": "data-engineer",
      "file": "data-engineer.md",
      "skill": "aiox-agent-data-engineer",
      "display": "Dara",
      "title": "Database Architect & Operations Engineer",
      "when": "Use for database design, schema architecture, Supabase configuration, RLS policies, migrations, query optimization, data modeling, operations, and monitoring"
    },
    {
      "id": "dev",
      "file": "dev.md",
      "skill": "aiox-agent-dev",
      "display": "Dex",
      "title": "Full Stack Developer",
      "when": "Use for code implementation, debugging, refactoring, and development best practices"
    },
    {
      "id": "devops",
      "file": "devops.md",
      "skill": "aiox-agent-devops",
      "display": "Gage",
      "title": "GitHub Repository Manager & DevOps Specialist",
      "when": "Use for repository operations, version management, CI/CD, quality gates, and GitHub push operations. ONLY agent authorized to push to remote repository."
    },
    {
      "id": "pm",
      "file": "pm.md",
      "skill": "aiox-agent-pm",
      "display": "Morgan",
      "title": "Product Manager",
      "when": "Use for PRD creation (greenfield and brownfield), epic creation and management, product strategy and vision, feature prioritization (MoSCoW, RICE), roadmap planning, business case development, go/no-go decisions, scope definition, success metrics, and stakeholder communication.\n\nEpic/Story Delegation (Gate 1 Decision): PM creates epic structure, then delegates story creation to @sm.\n\nNOT for: Market research or competitive analysis → Use @analyst. Technical architecture design or technology selection → Use @architect. Detailed user story creation → Use @sm (PM creates epics, SM creates stories). Implementation work → Use @dev.\n"
    },
    {
      "id": "po",
      "file": "po.md",
      "skill": "aiox-agent-po",
      "display": "Pax",
      "title": "Product Owner",
      "when": "Use for backlog management, story refinement, acceptance criteria, sprint planning, and prioritization decisions"
    },
    {
      "id": "qa",
      "file": "qa.md",
      "skill": "aiox-agent-qa",
      "display": "Quinn",
      "title": "Test Architect & Quality Advisor",
      "when": "Use for comprehensive test architecture review, quality gate decisions, and code improvement. Provides thorough analysis including requirements traceability, risk assessment, and test strategy. Advisory only - teams choose their quality bar."
    },
    {
      "id": "sm",
      "file": "sm.md",
      "skill": "aiox-agent-sm",
      "display": "River",
      "title": "Scrum Master",
      "when": "Use for user story creation from PRD, story validation and completeness checking, acceptance criteria definition, story refinement, sprint planning, backlog grooming, retrospectives, daily standup facilitation, and local branch management (create/switch/list/delete local branches, local merges).\n\nEpic/Story Delegation (Gate 1 Decision): PM creates epic structure, SM creates detailed user stories from that epic.\n\nNOT for: PRD creation or epic structure → Use @pm. Market research or competitive analysis → Use @analyst. Technical architecture design → Use @architect. Implementation work → Use @dev. Remote Git operations (push, create PR, merge PR, delete remote branches) → Use @github-devops.\n"
    },
    {
      "id": "squad-creator",
      "file": "squad-creator.md",
      "skill": "aiox-agent-squad-creator",
      "display": "Craft",
      "title": "Squad Creator",
      "when": "Use to create, validate, publish and manage squads"
    },
    {
      "id": "ux-design-expert",
      "file": "ux-design-expert.md",
      "skill": "aiox-agent-ux-design-expert",
      "display": "Uma",
      "title": "UX/UI Designer & Design System Architect",
      "when": "Complete design workflow - user research, wireframes, design systems, token extraction, component building, and quality assurance"
    }
  ],
